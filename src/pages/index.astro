---
import { ClientRouter, fade } from 'astro:transitions'
import App from '../App.jsx'
import appearance from '../content/appearance.json'
import gallery from '../content/gallery.json'
import gallerySettings from '../content/gallery-settings.json'
import seoSocial from '../content/seo-social.json'
import site from '../content/site.json'
import { createBackgroundStyle, getBackgroundThemeColor } from '../lib/backgroundStyle.js'
import { createGoogleFontSettings } from '../lib/googleFont.js'
import { getOptimizedUploadPath } from '../lib/imagePaths.js'
import '../styles.css'

const siteTitle = site.siteTitle?.trim() || 'Adrian Gaut'
const headline = site.headline?.trim() || siteTitle
const backgroundStyle = createBackgroundStyle(appearance)
const googleFont = createGoogleFontSettings(appearance.googleFontFamily)
const documentStyle = `${backgroundStyle}; ${googleFont.style}`
const backgroundThemeColor = getBackgroundThemeColor(appearance)
// Editors can tune search and sharing copy without changing the visible name.
const title = seoSocial.seoTitle?.trim() || siteTitle
const description = seoSocial.seoDescription?.trim()
  || 'The photography portfolio of Adrian Gaut.'
const socialImageAlt = seoSocial.socialImageAlt?.trim()
  || 'Selected work by Adrian Gaut'
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
const socialImageUrl = seoSocial.socialImage
  ? new URL(seoSocial.socialImage, Astro.site ?? Astro.url.origin)
  : null
// Replace only the browser-facing gallery URL. Sveltia's JSON continues to
// point at the original upload, so its media library remains fully editable.
const optimizedGalleryImages = gallery.images.map((entry) => ({
  ...entry,
  image: getOptimizedUploadPath(entry.image),
}))
const instagramUrl = site.instagramUrl?.trim() || 'https://www.instagram.com/a_gaut'
const subhead = site.subhead?.trim()
// Default to enabled so CMS documents created before this setting retain the
// existing character reveal.
const animateSubhead = site.animateSubhead !== false
const introStartDelay = 180
const introCharacterDelay = 55
const introCharacterDuration = 480
const introPhotoPause = 140

// Astro renders the animated characters into the initial HTML. Words remain
// intact, while the index preserves a natural timing pause between them.
let subheadCharacterIndex = 0
const rawSubheadWords = subhead.split(/\s+/)
const subheadWords = rawSubheadWords.map((word, wordIndex) => {
  const characters = Array.from(word).map((character) => {
    const index = subheadCharacterIndex
    subheadCharacterIndex += 1
    return { character, index }
  })

  if (wordIndex < rawSubheadWords.length - 1) subheadCharacterIndex += 1
  return { characters }
})
const introDuration = animateSubhead
  ? introStartDelay
    + Math.max(0, Array.from(subhead).length - 1) * introCharacterDelay
    + introCharacterDuration
    + introPhotoPause
  : 0
---

<!doctype html>
<html lang="en" style={documentStyle} transition:animate={fade({ duration: '0.35s' })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={backgroundThemeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {googleFont.href && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {googleFont.href && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {googleFont.href && <link rel="stylesheet" href={googleFont.href} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && <meta property="og:image:alt" content={socialImageAlt} />}
    <meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {socialImageUrl && <meta name="twitter:image:alt" content={socialImageAlt} />}
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <main class="studio-shell">
      <div class="studio-noise" aria-hidden="true"></div>

      <!-- React updates only this title's preload mask; the H1 is static HTML. -->
      <h1 class="brand-signature" data-title={headline}>{headline}</h1>

      <nav class="header-links" aria-label="Contact and social links">
        <a class="contact-link" href="/contact">Contact</a>
        <a
          class="instagram-link"
          href={instagramUrl}
          target="_blank"
          rel="noreferrer"
          aria-label="Visit Adrian Gaut on Instagram"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4.25"></circle>
            <circle class="instagram-dot" cx="17.4" cy="6.7" r="1"></circle>
          </svg>
        </a>
      </nav>

      <div class="subhead-wrap">
        <p class="subhead" aria-label={subhead}>
          {animateSubhead
            ? subheadWords.map((word, wordIndex) => (
              <>
                <span class="subhead-word" aria-hidden="true">
                  {word.characters.map(({ character, index }) => (
                    <span
                      class="subhead-character"
                      style={`animation-delay: ${introStartDelay + index * introCharacterDelay}ms; animation-duration: ${introCharacterDuration}ms;`}
                    >
                      {character}
                    </span>
                  ))}
                </span>
                {wordIndex < subheadWords.length - 1 && ' '}
              </>
            ))
            : subhead}
        </p>
      </div>

      <!-- Only the WebGL gallery and interactions require client-side React. -->
      <App
        images={optimizedGalleryImages}
        introDuration={introDuration}
        randomizePhotoOrder={gallerySettings.randomizePhotoOrder}
        enableAutoScroll={gallerySettings.enableAutoScroll === true}
        autoScrollSpeed={gallerySettings.autoScrollSpeed}
        enablePhotoFloating={gallerySettings.enablePhotoFloating !== false}
        enableDepthDarkening={gallerySettings.enableDepthDarkening === true}
        enableDepthOfField={gallerySettings.enableDepthOfField !== false}
        bokehStrength={gallerySettings.bokehStrength}
        backgroundOverlayOpacity={gallerySettings.backgroundOverlayOpacity}
        enableScrollMotionBlur={gallerySettings.enableScrollMotionBlur !== false}
        enableCarouselEdgeFade={gallerySettings.enableCarouselEdgeFade !== false}
        client:only="react"
      />
    </main>
  </body>
</html>
