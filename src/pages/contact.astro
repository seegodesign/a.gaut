---
import { ClientRouter, fade } from 'astro:transitions'
import appearance from '../content/appearance.json'
import contact from '../content/contact.json'
import seoSocial from '../content/seo-social.json'
import site from '../content/site.json'
import { createBackgroundStyle, getBackgroundThemeColor } from '../lib/backgroundStyle.js'
import { createGoogleFontSettings } from '../lib/googleFont.js'
import '../styles.css'

const siteTitle = site.siteTitle || 'Adrian Gaut'
const backgroundStyle = createBackgroundStyle(appearance)
const googleFont = createGoogleFontSettings(appearance.googleFontFamily)
const documentStyle = `${backgroundStyle}; ${googleFont.style}`
const backgroundThemeColor = getBackgroundThemeColor(appearance)
const title = `Contact — ${siteTitle}`
const description = 'Contact photographer Adrian Gaut and his representation.'
const socialImageAlt = seoSocial.socialImageAlt?.trim()
  || 'Selected work by Adrian Gaut'
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin)
const socialImageUrl = seoSocial.socialImage
  ? new URL(seoSocial.socialImage, Astro.site ?? Astro.url.origin)
  : null
const representationPrefix = contact.representationPrefix || 'Represented by'
const representationName = contact.representationName || 'EDGE REPS'
const representationUrl = contact.representationUrl || 'http://www.edgereps.com/'
const contactEmail = contact.email || 'adrian@agaut.com'
---

<!doctype html>
<html lang="en" style={documentStyle} transition:animate={fade({ duration: '0.35s' })}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content={backgroundThemeColor} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {googleFont.href && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {googleFont.href && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {googleFont.href && <link rel="stylesheet" href={googleFont.href} />}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    {socialImageUrl && <meta property="og:image:alt" content={socialImageAlt} />}
    <meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {socialImageUrl && <meta name="twitter:image:alt" content={socialImageAlt} />}
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <!-- This decorative layer matches the subtle texture on the gallery page. -->
    <div class="studio-noise" aria-hidden="true"></div>

    <main class="contact-page">
      <a class="brand-signature contact-brand" href="/" aria-label="Return to the gallery">
        {siteTitle}
      </a>

      <div class="contact-copy">
        <p>
          {representationPrefix}&nbsp;<a href={representationUrl}>{representationName}</a>
        </p>
        <p><a href={`mailto:${contactEmail}`}>{contactEmail}</a></p>
      </div>
    </main>
  </body>
</html>
